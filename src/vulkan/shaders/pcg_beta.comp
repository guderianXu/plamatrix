#version 450
layout(local_size_x = 1) in;
layout(std430, binding = 0) buffer State
{
    float rho;
    float alpha;
    float beta;
    float residual_squared;
    float tolerance_squared;
    uint flags;
    uint iterations;
} state;
layout(std430, binding = 1) readonly buffer NextRho { float values[]; } next_rho;
void main()
{
    if ((state.flags & 3u) != 0u)
        return;
    float previous = state.rho;
    float next = next_rho.values[0];
    if (isnan(previous) || isinf(previous) || previous <= 0.0 || isnan(next) || isinf(next) || next <= 0.0)
    {
        state.flags |= 2u;
        return;
    }
    state.beta = next / previous;
    state.rho = next;
    if (isnan(state.beta) || isinf(state.beta))
        state.flags |= 2u;
}
