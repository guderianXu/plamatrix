#version 450
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer Rhs { float rhs[]; };
layout(std430, binding = 1) readonly buffer Ax { float ax[]; };
layout(std430, binding = 2) readonly buffer InverseDiagonal { float inverse_diagonal[]; };
layout(std430, binding = 3) buffer Residual { float residual[]; };
layout(std430, binding = 4) buffer Transformed { float transformed[]; };
layout(std430, binding = 5) buffer Direction { float direction[]; };
layout(push_constant) uniform Params { uint count; } params;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.count) return;
    float r = rhs[i] - ax[i];
    float z = inverse_diagonal[i] * r;
    residual[i] = r;
    transformed[i] = z;
    direction[i] = z;
}
