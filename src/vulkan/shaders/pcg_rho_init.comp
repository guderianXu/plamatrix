#version 450
layout(local_size_x = 1) in;
layout(std430, binding = 0) buffer State
{
    float rho;
    float alpha;
    float beta;
    float residual_squared;
    float tolerance_squared;
    float initial_residual_squared;
    uint flags;
    uint iterations;
} state;
layout(std430, binding = 1) readonly buffer InitialRho { float values[]; } initial_rho;
void main()
{
    if ((state.flags & 3u) != 0u)
        return;
    float rho = initial_rho.values[0];
    if (isnan(rho) || isinf(rho) || rho <= 0.0)
    {
        state.flags |= 2u;
        return;
    }
    state.rho = rho;
}
