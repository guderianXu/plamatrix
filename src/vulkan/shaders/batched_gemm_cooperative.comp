#version 460
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer
{
    float16_t values[];
}
input_data;

layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer
{
    float values[];
}
output_data;

layout(push_constant) uniform Parameters
{
    uint batch_count;
    uint right_offset;
}
parameters;

void main()
{
    const uint batch = gl_WorkGroupID.x;
    if (batch >= parameters.batch_count)
    {
        return;
    }
    const uint offset = batch * 256u;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> matrix_a;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> matrix_b;
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> accumulator =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    coopMatLoad(matrix_a, input_data.values, offset, 16u, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(
        matrix_b, input_data.values, parameters.right_offset + offset, 16u, gl_CooperativeMatrixLayoutRowMajor);
    accumulator = coopMatMulAdd(matrix_a, matrix_b, accumulator);
    coopMatStore(accumulator, output_data.values, offset, 16u, gl_CooperativeMatrixLayoutRowMajor);
}
