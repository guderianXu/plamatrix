#version 450
layout(local_size_x = 128) in;
layout(std430, binding = 0) buffer Direction { float direction[]; };
layout(std430, binding = 1) readonly buffer Transformed { float transformed[]; };
layout(std430, binding = 2) readonly buffer State
{
    float rho;
    float alpha;
    float beta;
    float residual_squared;
    float tolerance_squared;
    float initial_residual_squared;
    uint flags;
    uint iterations;
} state;
layout(push_constant) uniform Params { uint count; } params;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < params.count && (state.flags & 3u) == 0u)
        direction[i] = transformed[i] + state.beta * direction[i];
}
