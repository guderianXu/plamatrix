#version 450
layout(local_size_x = 128) in;
layout(std430, binding = 0) buffer Direction { float direction[]; };
layout(std430, binding = 1) readonly buffer Transformed { float transformed[]; };
layout(push_constant) uniform Params { uint count; float beta; } params;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < params.count) direction[i] = transformed[i] + params.beta * direction[i];
}
