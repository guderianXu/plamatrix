#version 450
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer Rhs { float rhs[]; };
layout(std430, binding = 1) readonly buffer Ax { float ax[]; };
layout(std430, binding = 2) buffer Residual { float residual[]; };
layout(push_constant) uniform Params { uint count; } params;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < params.count) residual[i] = rhs[i] - ax[i];
}
