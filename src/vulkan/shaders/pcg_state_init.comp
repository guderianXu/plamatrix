#version 450
layout(local_size_x = 1) in;
layout(std430, binding = 0) buffer State
{
    float rho;
    float alpha;
    float beta;
    float residual_squared;
    float tolerance_squared;
    float initial_residual_squared;
    uint flags;
    uint iterations;
} state;
layout(std430, binding = 1) readonly buffer InitialResidual { float values[]; } initial_residual;
layout(push_constant) uniform Params
{
    float relative_tolerance_squared;
    float absolute_tolerance_squared;
} params;
void main()
{
    float residual = initial_residual.values[0];
    state.rho = 0.0;
    state.alpha = 0.0;
    state.beta = 0.0;
    state.residual_squared = residual;
    state.initial_residual_squared = residual;
    state.tolerance_squared =
        max(params.absolute_tolerance_squared, params.relative_tolerance_squared * residual);
    state.flags = 0u;
    state.iterations = 0u;
    if (isnan(residual) || isinf(residual) || residual < 0.0)
    {
        state.flags |= 2u;
        return;
    }
    if (residual <= state.tolerance_squared)
    {
        state.flags |= 1u;
        return;
    }
}
