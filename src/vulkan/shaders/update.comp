#version 450
layout(local_size_x = 128) in;
layout(std430, binding = 0) buffer Solution { float solution[]; };
layout(std430, binding = 1) buffer Residual { float residual[]; };
layout(std430, binding = 2) readonly buffer Direction { float direction[]; };
layout(std430, binding = 3) readonly buffer MatrixDirection { float matrix_direction[]; };
layout(std430, binding = 4) readonly buffer State
{
    float rho;
    float alpha;
    float beta;
    float residual_squared;
    float tolerance_squared;
    uint flags;
    uint iterations;
} state;
layout(push_constant) uniform Params { uint count; } params;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < params.count && (state.flags & 3u) == 0u)
    {
        solution[i] += state.alpha * direction[i];
        residual[i] -= state.alpha * matrix_direction[i];
    }
}
